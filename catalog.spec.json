{
  "$schema": "https://raw.githubusercontent.com/yschimke/compose-ai-tools/main/scripts/design-artifacts/catalog.spec.schema.json",
  "$comment": "Home Assistant Companion phone/tablet catalog rendered from the fullDebug variant of :app. Full destinations use device-sized previews; state-hoisted settings bodies and dialogs remain wrap-content component previews. Synthetic Hilt Activity entries are intentionally excluded.",
  "system": "home-assistant-android",
  "title": "Home Assistant Companion",
  "library": [
    "Jetpack Compose Material + Home Assistant theme"
  ],
  "module": ":app",
  "modes": [
    "light",
    "dark"
  ],
  "breakpoints": [
    {
      "size": "compact",
      "widthDp": 400
    },
    {
      "size": "medium",
      "widthDp": 700
    }
  ],
  "display": {
    "surface": "light",
    "hero": "Onboarding/Welcome"
  },
  "groupOrder": [
    "Onboarding",
    "Wear settings",
    "Commissioning",
    "Management",
    "Settings content",
    "Dialogs"
  ],
  "groups": [
    {
      "name": "Onboarding",
      "section": "Screens",
      "components": [
        {
          "componentId": "Onboarding/Welcome",
          "preview": "PreviewWelcome",
          "caption": "Full compact-device welcome destination with system chrome and light/dark annotations."
        },
        {
          "componentId": "Onboarding/Notification permission",
          "preview": "NotificationPermissionViewPreview",
          "caption": "Full compact-device notification-permission education destination."
        }
      ]
    },
    {
      "name": "Wear settings",
      "section": "Screens",
      "components": [
        {
          "componentId": "Settings/Wear companion",
          "preview": "PreviewSettingWearLandingView",
          "caption": "Full compact-device destination for configuring a paired Wear OS companion.",
          "variants": [
            {
              "preview": "PreviewWearFavorites",
              "caption": "State-hoisted phone-side favorite editor for a paired Wear OS companion in light and dark themes.",
              "state": "favorites"
            }
          ]
        }
      ]
    },
    {
      "name": "Commissioning",
      "section": "Components",
      "components": [
        {
          "componentId": "Onboarding/Matter commissioning",
          "preview": "PreviewMatterCommissioningView",
          "caption": "Wrap-content Matter commissioning panel across the states supplied by MatterCommissioningViewPreviewStates."
        }
      ]
    },
    {
      "name": "Management",
      "section": "Screens",
      "components": [
        {
          "componentId": "Settings/Quick settings tiles",
          "preview": "PreviewManageTiles",
          "caption": "State-hoisted quick settings tile editor with entity, server, icon, vibration, and authentication controls in light and dark themes."
        },
        {
          "componentId": "Settings/App shortcuts",
          "preview": "PreviewManageShortcuts",
          "caption": "State-hoisted app shortcut editor populated with a configured dashboard shortcut in light and dark themes."
        },
        {
          "componentId": "Settings/Android Auto favorites",
          "preview": "PreviewAndroidAutoFavorites",
          "caption": "State-hoisted vehicle favorite picker and reorderable favorite list in light and dark themes."
        },
        {
          "componentId": "Settings/Sensor list",
          "preview": "PreviewSensorList",
          "caption": "State-hoisted sensor manager list with enabled battery sensors in light and dark themes."
        },
        {
          "componentId": "Settings/Widgets",
          "preview": "PreviewManageWidgets",
          "caption": "State-hoisted widget management destination with all supported widget types in light and dark themes."
        }
      ]
    },
    {
      "name": "Settings content",
      "section": "Components",
      "components": [
        {
          "componentId": "Settings/Wi-Fi SSIDs",
          "preview": "PreviewSsidViewItems",
          "caption": "Wrap-content Wi-Fi settings body with saved networks and connection state.",
          "variants": [
            {
              "preview": "PreviewSsidViewEmpty",
              "caption": "Empty state before any SSIDs are saved.",
              "state": "empty"
            }
          ]
        },
        {
          "componentId": "Settings/External URL",
          "preview": "PreviewExternalUrlViewCloudOn",
          "caption": "Wrap-content external connection settings body with Home Assistant Cloud connected.",
          "variants": [
            {
              "preview": "PreviewExternalUrlViewCloudOff",
              "caption": "Cloud is configured but disconnected.",
              "state": "cloud-off"
            },
            {
              "preview": "PreviewExternalUrlViewCloudNone",
              "caption": "No cloud connection is configured.",
              "state": "cloud-unavailable"
            }
          ]
        },
        {
          "componentId": "Settings/Notification detail",
          "preview": "PreviewNotificationDetails",
          "caption": "Wrap-content notification detail controls and explanatory content."
        }
      ]
    },
    {
      "name": "Dialogs",
      "section": "Components",
      "components": [
        {
          "componentId": "Components/Icon dialog",
          "preview": "IconDialogPreview",
          "caption": "Icon picker dialog shell with search and result content.",
          "variants": [
            {
              "preview": "IconDialogSearchPreview",
              "caption": "Search-field component used by the icon picker.",
              "state": "search"
            },
            {
              "preview": "IconDialogGridPreview",
              "caption": "Scrollable icon result grid.",
              "state": "results"
            }
          ]
        }
      ]
    }
  ]
}
